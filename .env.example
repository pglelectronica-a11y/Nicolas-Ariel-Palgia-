# Copiar este archivo a .env y completar con valores reales.
# .env nunca se versiona (ver .gitignore).

# Cadena de conexión a PostgreSQL. En producción, un proveedor administrado
# (Neon, Supabase — PCS sección 9.2). En desarrollo local, cualquier
# instancia de PostgreSQL 14+ sirve — por ejemplo, la instalada localmente
# para validar el Módulo 2:
# DATABASE_URL="postgresql://postgres:pglclub_dev@localhost:5432/pgl_club?schema=public"
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/pgl_club?schema=public"

# Clave para firmar la cookie de sesión del administrador (Sprint 4, sección
# 4.1, implementada en el Módulo 5). Tiene que ser larga, aleatoria, y
# nunca la misma entre entornos. Generarla, por ejemplo, con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET="reemplazar-por-un-valor-aleatorio-largo"
